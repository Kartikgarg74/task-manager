# Postgres (Supabase-hosted, used as plain managed Postgres — no Supabase client SDK)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Timezone every cron/date calculation is anchored to (see Sheet 04's note on the IST bug)
APP_TIMEZONE=Asia/Kolkata

# Web app auth — single user, per project decision (private hosting, no public signup)
WEB_AUTH_SECRET=change-me
WEB_AUTH_EMAIL=you@example.com
WEB_AUTH_PASSWORD_HASH=

# Morning notification (Sheet 06) — env var, not a settings table, since it never changes
NOTIFY_EMAIL=you@example.com
RESEND_API_KEY=

# Shared secret the GitHub Actions cron workflows send as X-Cron-Secret —
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_CRON_SECRET=

# Bootstrap device token (see devices table) — printed once by `scripts/create_device.py`,
# never stored in plaintext after that
